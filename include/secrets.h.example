#ifndef SECRETS_H
#define SECRETS_H

// ============================================================================
// SECRETS — DO NOT COMMIT THE REAL secrets.h FILE
// ============================================================================
// Copy this file to `secrets.h` (same directory) and fill in your real values.
// `secrets.h` is gitignored.

#define WIFI_SSID "YOUR_WIFI_SSID"
#define WIFI_PASSWORD "YOUR_WIFI_PASSWORD"

// Static IP override (optional). Leave 0,0,0,0 to use DHCP.
#define STATIC_IP_OCTET_1 0
#define STATIC_IP_OCTET_2 0
#define STATIC_IP_OCTET_3 0
#define STATIC_IP_OCTET_4 0

// Optional shared secret for the REST API. When non-empty, every request to
// /api/* must carry header `X-Auth-Token: <value>` (the dashboard sends it
// automatically once you paste it into the topbar token field). Leave empty to
// allow open access on the LAN.
#define API_TOKEN ""

#endif // SECRETS_H
